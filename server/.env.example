MONGO_URI=
PORT=
GMAIL_USER=
GMAIL_PASS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# AI chatbot (/api/chatbot) — uses Claude (Anthropic API)
# Create a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_EFFORT=medium
# Long random string used to sign chat tokens, e.g. output of:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CHATBOT_SECRET=
